# Server-side only. Never prefix these with NEXT_PUBLIC_: the API key must not reach the browser.
ULIS_API_URL=http://localhost:8000
ULIS_API_KEY=

# Research assistant (early access). See docs/early-access.md.
# Comma-separated invite codes. Unset in production = research routes refuse to serve.
EARLY_ACCESS_CODES=
# At least 16 random characters; signs the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Research runs per invite code per UTC day (per instance; 0 = unlimited). Default 20.
RESEARCH_DAILY_LIMIT=20
# Where feedback JSON lines are appended. Default ./feedback.jsonl
FEEDBACK_FILE=
# Development and tests only: scripted fictional results, no backend LLM needed.
ULIS_RESEARCH_MOCK=
